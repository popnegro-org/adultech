{
  "name": "adultech",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "prebuild": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "test:db": "node scripts/smoke-db.mjs",
    "cf:install": "npm install --no-save --package-lock=false @opennextjs/cloudflare@1.20.18 wrangler@4.165.0",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.2",
    "next": "15.5.29",
    "next-auth": "5.0.0-beta.32",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@types/node": "22.19.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.29",
    "prisma": "6.19.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "deepmerge-ts@^7": "^8.0.2",
    "postcss": "^8.5.23",
    "effect": "^3.22.1"
  },
  "description": "Adultech Creator CRM — privacy-first workspace for adult creators"
}
